# ---------------------------------------------------------------------------
# Ankit Stationery Mart — backend configuration
# Copy to backend/.env (or set the same names in Render's environment panel).
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# --- database ---------------------------------------------------------------
# Local demo (zero setup, survives restarts):
DATABASE_URL=sqlite:///./asm_dev.db
# Supabase / Postgres (use the pooler connection string from Dashboard -> Connect):
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- identity ---------------------------------------------------------------
# Leave blank for demo sign-in. Fill all three to switch to Google + Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Dashboard -> Settings -> API -> JWT Settings -> JWT Secret.
# Optional: if left blank the backend verifies tokens against the project's JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Passwordless demo sign-in. MUST be false in production.
DEV_AUTH=true
DEV_JWT_SECRET=change-me-to-a-long-random-string
DEV_JWT_TTL_HOURS=168

# --- payments ---------------------------------------------------------------
# Leave the keys blank to run the documented mock flow (no real charges).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks -> secret. Never expose this to the browser.
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_MOCK=true

# --- storefront rules (integer paise) --------------------------------------
FREE_SHIPPING_THRESHOLD_PAISE=49900
SHIPPING_FEE_PAISE=4900
COD_ENABLED=true
PICKUP_ENABLED=true
MAX_QUANTITY_PER_LINE=10

STORE_PHONE=+91 98160 00000
STORE_EMAIL=hello@ankitstationery.in
STORE_ADDRESS=Shop 12, Lower Bazaar, The Mall Road, Shimla, Himachal Pradesh 171001
STORE_HOURS=Mon–Sat, 9:30 am – 8:00 pm · Sunday 11:00 am – 5:00 pm

# --- plumbing ---------------------------------------------------------------
# Comma-separated production origins (preview hosts are allowed automatically
# while ALLOW_PREVIEW_ORIGINS is true).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_PREVIEW_ORIGINS=true
SEED_ON_STARTUP=true
