# Ankit Stationery Mart — configuration
# Copy to backend/.env (or export in the process environment).
# Never commit a real .env file.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# development | production | test
APP_ENV=development

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite for development; PostgreSQL for production.
# DATABASE_URL=sqlite:////absolute/path/to/asm.db
# Managed hosts may hand out postgres://…; that is normalised automatically.
# DATABASE_URL=postgresql+psycopg://asm_user:password@127.0.0.1:5432/asm
DATABASE_URL=sqlite:///data/asm.db

# Where uploaded product/listing photos are stored (persist this directory).
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=4194304

# Absolute path to the compiled SPA. Defaults to ../frontend/dist.
# FRONTEND_DIST=/srv/ankit-stationery-mart/frontend/dist

# Public origin used in sitemap.xml and robots.txt.
# PUBLIC_SITE_URL=https://example.com

# Extra allowed origins for credentialed CORS (comma separated, normally empty).
TRUSTED_ORIGINS=

# Set to 1 only when serving over HTTPS. Defaults to 1 when APP_ENV=production.
# SECURE_COOKIES=1

# ---------------------------------------------------------------------------
# Demo / seeded sample data
# ---------------------------------------------------------------------------
# 1 = create demo products, listings, FAQs and accounts on first start.
# NEVER enable on a live store with real customers.
SEED_DEMO=0
# DEMO_ADMIN_EMAIL=demo.admin@example.com
# DEMO_ADMIN_PASSWORD=
# DEMO_CUSTOMER_PASSWORD=
# ADMIN_BOOTSTRAP_EMAIL=            # only used by the seed command

# ---------------------------------------------------------------------------
# Google Sign-In (optional). Create an OAuth 2.0 Web client id at
# https://console.cloud.google.com/apis/credentials and add your site origin to
# its "Authorised JavaScript origins". Leave blank to disable the Google button;
# the API then reports it as unavailable instead of offering a broken flow.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
# Optional: restrict sign-in to one Google Workspace domain (e.g. a school).
GOOGLE_HOSTED_DOMAIN=

# ---------------------------------------------------------------------------
# Payments (Razorpay). Online payment stays disabled until BOTH the keys and
# the webhook secret below are present; the storefront then shows COD/pickup only.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email (optional). Without SMTP, notifications are stored in-app and logged
# with status "skipped" — nothing is silently reported as sent.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# Console provider prints notification bodies instead of emailing. Dev only.
NOTIFICATION_CONSOLE_PROVIDER=0
# NOTIFICATION_OUTBOX=/tmp/notifications.log

# ---------------------------------------------------------------------------
# Rate limits: requests per fixed window, measured per client IP and route.
# Windows are 300 s (login) and 600 s (other writes).
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN=8
RATE_LIMIT_PUBLIC_WRITE=20
RATE_LIMIT_CHECKOUT=12

# Minutes a checkout holds stock before the reservation expires.
STOCK_RESERVATION_MINUTES=30
