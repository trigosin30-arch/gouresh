# Leave empty for local development: Vite proxies /api to the FastAPI server.
# Set to the deployed API origin when the storefront is hosted separately,
# e.g. VITE_API_BASE_URL=https://asm-api.onrender.com
VITE_API_BASE_URL=

# Where the dev server proxies /api (defaults to http://127.0.0.1:8000)
VITE_API_PROXY=http://127.0.0.1:8000
